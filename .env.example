# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# TheSportsDB (https://www.thesportsdb.com/) — fuente de resultados del torneo
# '3' es la key de test pública; regístrate en thesportsdb.com para una free key con mayor cuota
THESPORTSDB_KEY=3

# Cron secret — genera uno con: openssl rand -hex 32
CRON_SECRET=<random-secret>
