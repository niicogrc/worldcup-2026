# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# TheSportsDB (https://www.thesportsdb.com/) — fuente de resultados del torneo
# '3' es la key de test pública; regístrate en thesportsdb.com para una free key con mayor cuota
THESPORTSDB_KEY=3

# Cron secret — genera uno con: openssl rand -hex 32
CRON_SECRET=<random-secret>

# Notificaciones de Discord al terminar partidos (opcional)
# Si DISCORD_WEBHOOK_URL no está, el sync no notifica nada (cero impacto).
# Crea el webhook en: Ajustes del canal → Integraciones → Webhooks → Nuevo
DISCORD_WEBHOOK_URL=<discord-webhook-url>
# Gemini API (free tier): https://aistudio.google.com/apikey
# Narra el mensaje con un LLM. Sin esta key se envía una plantilla fija.
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash
